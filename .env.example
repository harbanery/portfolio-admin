# ============================================================
# ENVIRONMENT VARIABLES — contoh (salin ke .env / .env.development)
# ============================================================

TITLE_WEB="Raihan Yusuf's Admin Portfolio"
APP_WEB="My Admin Portfolio"
DESCRIPTION_WEB="Welcome to my admin portfolio website."

NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"

# PostgreSQL (Railway) — transaction mode untuk pooler + direct mode
DATABASE_URL="postgresql://user:password@host:port/db?schema=public"
DIRECT_URL="postgresql://user:password@host:port/db?schema=public"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (Nodemailer SMTP) — untuk generate & kirim password admin baru.
# Fitur generate password hanya aktif saat NODE_ENV === "development".
# Isi dengan kredensial SMTP Anda (mis. Gmail: smtp.gmail.com:465 + App Password).
# Kosongkan SMTP_HOST untuk menonaktifkan channel email.
SMTP_HOST=""
SMTP_PORT="465"
# Kosongkan untuk auto-detect (secure=true jika port 465, else STARTTLS)
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Alamat pengirim (opsional, default = SMTP_USER)
SMTP_FROM=""
# Alamat penerima password admin (single-user app)
NOTIFICATION_EMAIL_TO=""

# Bahasa konten email server-side (id | en). Default: id
NOTIFICATION_LOCALE="id"
